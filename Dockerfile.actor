# nng is built from source, pinned. Alpine 3.24 ships 1.11; 1.12.3 carries the
# websocket and allocation-limit fixes that matter once the bus listens on
# ws://. Static, so the image needs no nng package at run time. CPATH and
# LIBRARY_PATH point gcc at it, so the build lines below stay as they are.
FROM alpine:3.24 AS nng
ARG NNG_VERSION=1.12.3
ARG NNG_SHA256=036a925790034efdeef8a6803f3e4402c3ab509383326f8bc2f15ecee75a2fa2
RUN apk add --no-cache gcc musl-dev cmake make curl
RUN curl -fsSL -o /tmp/nng.tar.gz \
        "https://github.com/nanomsg/nng/archive/refs/tags/v${NNG_VERSION}.tar.gz" && \
    echo "${NNG_SHA256}  /tmp/nng.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/nng.tar.gz -C /tmp && \
    cmake -S "/tmp/nng-${NNG_VERSION}" -B /tmp/nng-build \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
        -DNNG_TESTS=OFF -DNNG_TOOLS=OFF \
        -DCMAKE_INSTALL_PREFIX=/opt/nng -DCMAKE_INSTALL_LIBDIR=lib && \
    cmake --build /tmp/nng-build -j "$(nproc)" && \
    cmake --install /tmp/nng-build

FROM alpine:3.24 AS builder
RUN apk add --no-cache gcc musl-dev lmdb-dev
COPY --from=nng /opt/nng /opt/nng
ENV CPATH=/opt/nng/include LIBRARY_PATH=/opt/nng/lib

# ── Actor runtime ──────────────────────────────────────────────────
COPY runtime/ /src/runtime/
WORKDIR /src
RUN gcc -Wall -Wextra -Os -std=c11 \
    runtime/main.c runtime/actor.c runtime/actor_isolation.c runtime/bus.c \
    -lnng -llmdb -o /actor && \
    strip /actor

# ── Confinement wrapper ─────────────────────────────────────────────
# A handler that must keep a capability while denying it to what it spawns
# opens the connection, execs this, then spawns. No nng or lmdb: it links the
# isolation unit alone.
COPY tools/actor-confine.c /src/tools/
RUN gcc -Wall -Wextra -Os -std=c11 \
    tools/actor-confine.c runtime/actor_isolation.c -o /actor-confine && \
    strip /actor-confine

# ── Echo handler ────────────────────────────────────────────────────
COPY handlers/echo.c /src/handlers/
RUN mkdir -p /handlers && \
    gcc -Wall -Wextra -Os -std=c11 handlers/echo.c -o /handlers/echo && \
    strip /handlers/echo

FROM alpine:3.24
RUN apk add --no-cache lmdb
COPY --from=builder /actor /actor
COPY --from=builder /actor-confine /actor-confine
COPY --from=builder /handlers/echo /handlers/echo
EXPOSE 5556 5557
ENTRYPOINT ["/actor"]
