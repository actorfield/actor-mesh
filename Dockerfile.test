# Mirrors Dockerfile.actor's base and deps, plus what the tests need.
# nng from source, pinned and static -- see Dockerfile.actor. CPATH and
# LIBRARY_PATH also cover the Makefile's test targets run in this image.
FROM alpine:3.24 AS nng
ARG NNG_VERSION=1.12.3
ARG NNG_SHA256=036a925790034efdeef8a6803f3e4402c3ab509383326f8bc2f15ecee75a2fa2
RUN apk add --no-cache gcc musl-dev cmake make curl
RUN curl -fsSL -o /tmp/nng.tar.gz \
        "https://github.com/nanomsg/nng/archive/refs/tags/v${NNG_VERSION}.tar.gz" && \
    echo "${NNG_SHA256}  /tmp/nng.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/nng.tar.gz -C /tmp && \
    cmake -S "/tmp/nng-${NNG_VERSION}" -B /tmp/nng-build \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
        -DNNG_TESTS=OFF -DNNG_TOOLS=OFF \
        -DCMAKE_INSTALL_PREFIX=/opt/nng -DCMAKE_INSTALL_LIBDIR=lib && \
    cmake --build /tmp/nng-build -j "$(nproc)" && \
    cmake --install /tmp/nng-build

FROM alpine:3.24
RUN apk add --no-cache gcc musl-dev lmdb-dev make iproute2 procps
COPY --from=nng /opt/nng /opt/nng
ENV CPATH=/opt/nng/include LIBRARY_PATH=/opt/nng/lib
WORKDIR /src
COPY runtime/ /src/runtime/
COPY proxy/   /src/proxy/
COPY tests/   /src/tests/
# test-mesh's registry test runs the example tool registry and its mpack-get
COPY vendor/mpack/ /src/vendor/mpack/
COPY examples/employee-mesh/Makefile  /src/examples/employee-mesh/
COPY examples/employee-mesh/handlers/ /src/examples/employee-mesh/handlers/
RUN mkdir -p bin && \
    gcc -Wall -Wextra -O2 -std=c11 -Iruntime \
        runtime/main.c runtime/actor.c runtime/actor_isolation.c runtime/bus.c \
        -lnng -llmdb -o bin/actor && \
    gcc -Wall -Wextra -O2 -std=c11 -Iruntime proxy/proxy.c runtime/bus.c -lnng -llmdb -o bin/mesh-proxy && \
    gcc -Wall -Wextra -O2 -std=c11 -Iruntime tests/test-isolation.c -lnng -o bin/test-isolation && \
    gcc -Wall -Wextra -O2 -std=c11 tests/test-concurrency.c -lnng -o bin/test-concurrency && \
    gcc -Wall -Wextra -O2 -std=c11 tests/test-mesh.c -lnng -o bin/test-mesh && \
    make -B -C examples/employee-mesh handlers/lib/mpack-get
CMD ["/bin/sh"]
